# Public URL of the deployed site, with trailing slash.
# The base path is derived from it automatically:
#   https://USERNAME.github.io/REPOSITORY/  ->  base "/REPOSITORY/"
#   https://example.com/                    ->  base "/"
# In GitHub Actions this is filled in by actions/configure-pages (see .github/workflows/deploy.yml).
SITE_URL=http://localhost:4173/
