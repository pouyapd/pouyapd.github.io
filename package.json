{
  "name": "p-design-site",
  "private": true,
  "version": "1.0.0",
  "description": "P. DESIGN — independent design and development studio website",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "check": "npm run lint && npm run build && node scripts/check-dist.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "brand": "python tools/brand/make_logo.py && python tools/brand/wordmarks.py",
    "og": "node scripts/og-card.mjs",
    "assets": "node scripts/build-assets.mjs",
    "mockups": "node scripts/mockups.mjs",
    "captures": "node scripts/captures.mjs",
    "render:stella": "node scripts/render-stills.mjs",
    "render:lifts": "node scripts/render-lifts-stills.mjs",
    "render:gateway": "blender -b -P tools/scene/gateway.py -- --variant desktop && blender -b -P tools/scene/gateway.py -- --variant mobile && node tools/scene/grade.mjs",
    "references": "python tools/references/prepare.py",
    "photos": "python tools/photos/prepare.py"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  }
}
